# Copiar a .env y llenar con valores reales. .env NUNCA se commitea (ver .gitignore).

# --- Base de datos ---
# En desarrollo (perfil "dev") estos valores alimentan docker-compose.yml y application-dev.yml.
# En produccion (perfil "prod") deben apuntar al RDS real via variables de entorno del EC2 (no a este archivo).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=marketplace_dev
DB_USERNAME=marketplace
DB_PASSWORD=change-me

# --- Telegram (usado por el servicio de alertas) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Scraper (Facebook Marketplace / Playwright) ---
# Ruta del archivo de sesion de Facebook (storageState de Playwright).
# Se genera con FacebookSessionBootstrap. NUNCA debe apuntar dentro del repo
# ni commitearse (ya cubierto por .gitignore, pero la ruta default tampoco
# vive en el repo).
SCRAPER_SESSION_FILE=
# true siempre en produccion; false solo para depurar selectores localmente
SCRAPER_HEADLESS=true
SCRAPER_DELAY_MIN_MS=3000
SCRAPER_DELAY_MAX_MS=8000
SCRAPER_BASE_LOCATION=Mérida, Yucatán, México
SCRAPER_MAX_RESULTS_PER_SEARCH=20

# --- Scheduler (pipeline scraper -> analisis -> alertas) ---
# false en desarrollo para no scrapear Facebook sin querer al levantar la
# app; true en produccion (default ya cubierto en application-prod.yml).
SCHEDULER_ENABLED=false

# --- Dashboard (endpoint /api/opportunities + frontend, HTTP Basic) ---
# En dev tienen default ("dev"/"dev") si no se configuran. En produccion son
# obligatorias -- la app falla al arrancar si faltan.
DASHBOARD_USERNAME=dev
DASHBOARD_PASSWORD=change-me
